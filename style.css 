
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f2f6fc;
    color: #102b50;
    min-height: 100vh;
}

/* Header */
header {
    background: #102b50;
    color: white;
    padding: 22px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

header h2 {
    font-size: 25px;
    letter-spacing: 1px;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
    font-size: 15px;
}

/* Main Section */
main {
    min-height: 75vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 30px 15px;
}

.hero {
    background: white;
    width: 100%;
    max-width: 750px;
    padding: 65px 25px;
    text-align: center;
    border-radius: 18px;
    box-shadow: 0 5px 25px rgba(16, 43, 80, 0.10);
}

.hero h1 {
    font-size: 36px;
    margin-bottom: 18px;
    color: #102b50;
}

.hero p {
    font-size: 17px;
    color: #64748b;
    margin-bottom: 30px;
}

/* Buttons */
.btn {
    display: inline-block;
    background: #155eef;
    color: white;
    text-decoration: none;
    padding: 14px 25px;
    margin: 8px;
    border-radius: 8px;
    font-weight: bold;
    transition: 0.3s;
}

.btn:hover {
    background: #102b50;
}

/* Footer */
footer {
    background: #102b50;
    color: white;
    text-align: center;
    padding: 22px;
    font-size: 14px;
}

/* Mobile Responsive */
@media (max-width: 600px) {
    header {
        flex-direction: column;
        gap: 15px;
    }

    nav a {
        margin: 8px;
    }

    .hero {
        padding: 40px 15px;
    }

    .hero h1 {
        font-size: 27px;
    }
}

